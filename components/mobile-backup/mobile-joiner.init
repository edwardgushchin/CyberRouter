#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=10
start_service() {
    local provider iface dns
    provider=$(cat /var/run/mobile-backup/provider 2>/dev/null) || return 1
    case "$provider" in telemost|wbstream|vk) ;; *) return 1;; esac
    iface=$(cat /var/run/mobile-backup/interface) || return 1
    dns=$(cat /var/run/mobile-backup/bootstrap-dns) || return 1
    procd_open_instance
    procd_set_param command /usr/local/bin/router-joiner --config "/etc/mobile-backup/$provider/config.json" --dns "$dns" --interface "$iface"
    procd_set_param env GOMAXPROCS=2
    procd_set_param respawn 60 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
