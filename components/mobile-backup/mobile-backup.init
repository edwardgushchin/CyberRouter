#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
start_service() {
    procd_open_instance proxy
    procd_set_param command /usr/bin/xray run -config /etc/mobile-backup/xray.json
    procd_set_param respawn
    procd_close_instance
    [ "$(cat /etc/mobile-backup/enabled 2>/dev/null)" = 1 ] || return 0
    procd_open_instance controller
    procd_set_param command /usr/sbin/mobile-backup run
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
